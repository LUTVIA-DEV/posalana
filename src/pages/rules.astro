---
import Layout from "../layouts/Layout.astro";
import db from "../db/index.js";
import { getRollSchedule } from "../utils/schedule.js";

const schedule = await getRollSchedule(db);
---

<Layout>
  <div
    class="space-y-10 animate-in fade-in duration-500 ease-out"
  >
    <!-- Header Section -->
    <section class="text-center pb-8 border-b border-foreground/5 animate-in fade-in slide-in-from-bottom-4 duration-500 delay-75 ease-out">
      <h2
        class="text-4xl md:text-5xl font-black mb-4 tracking-tight text-foreground text-balance"
      >
        Reglas del POSALANA
      </h2>
      <p class="text-lg text-foreground/60 max-w-2xl mx-auto text-pretty">
        El reglamento oficial para definir quién pone, saca, lava, o se salva de
        hacer nada.
      </p>
      <p
        class="text-xs text-foreground/40 mt-4 uppercase tracking-widest font-bold"
      >
        Última actualización: 13 Oct 2026
      </p>
    </section>

    <!-- The Meaning -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start animate-in fade-in slide-in-from-bottom-4 duration-500 delay-150 ease-out">
      <div
        class="bg-white border border-foreground/10 p-8 rounded-3xl shadow-lg hover-card-lift"
      >
        <h3
          class="text-2xl font-bold mb-6 flex items-center gap-3 text-balance"
        >
          <i class="fa-solid fa-circle-question text-secondary"></i> ¿Qué es POSALANA?
        </h3>
        <p class="text-foreground/80 leading-relaxed mb-6 text-pretty">
          Todos los días, cada participante debe tirar los dados una vez para
          definir su tarea en la mesa. Las tareas se asignan desde el tiro más
          bajo (peor suerte) hasta el más alto.
        </p>

        <ul class="space-y-4">
          <li
            class="flex items-center gap-4 p-3 rounded-chico hover:bg-foreground/5 transition-colors"
          >
            <span
              class="shrink-0 flex items-center justify-center w-12 h-12 bg-accent/20 text-accent font-black rounded-chico"
              >LA</span
            >
            <div>
              <p class="font-bold">Lava los platos</p>
              <p class="text-xs text-foreground/50">El peor tiro absoluto 🧽</p>
            </div>
          </li>
          <li
            class="flex items-center gap-4 p-3 rounded-chico hover:bg-foreground/5 transition-colors"
          >
            <span
              class="shrink-0 flex items-center justify-center w-12 h-12 bg-secondary/20 text-secondary font-black rounded-chico"
              >SA</span
            >
            <div>
              <p class="font-bold">Saca la mesa</p>
              <p class="text-xs text-foreground/50">El segundo peor tiro 🗑️</p>
            </div>
          </li>
          <li
            class="flex items-center gap-4 p-3 rounded-chico hover:bg-foreground/5 transition-colors"
          >
            <span
              class="shrink-0 flex items-center justify-center w-12 h-12 bg-primary/20 text-primary font-black rounded-chico"
              >PO</span
            >
            <div>
              <p class="font-bold">Pone la mesa</p>
              <p class="text-xs text-foreground/50">El tercer peor tiro 🍽️</p>
            </div>
          </li>
          <li
            class="flex items-center gap-4 p-3 rounded-chico hover:bg-foreground/5 transition-colors"
          >
            <span
              class="shrink-0 flex items-center justify-center w-12 h-12 bg-foreground/10 text-foreground font-black rounded-chico"
              >NA</span
            >
            <div>
              <p class="font-bold">Nada</p>
              <p class="text-xs text-foreground/50">
                ¡Zafaste, no hacés nada! 🎉
              </p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Mecánica -->
      <div class="space-y-8">
        <div
          class="bg-white border border-foreground/10 p-8 rounded-3xl shadow-lg hover-card-lift"
        >
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            <i class="fa-solid fa-dice text-secondary"></i> La Tirada
          </h3>
          <ul class="space-y-3 text-foreground/80 list-disc pl-5">
            <li>
              Se tiran <strong>4 dados</strong> una vez por día en la app.
            </li>
            <li>
              El tiro más bajo en el 1º dado <strong class="text-primary"
                >LAVA</strong
              >, el 2º <strong class="text-primary">SACA</strong>, el 3º <strong
                class="text-primary">PONE</strong
              >.
            </li>
            <li>
              En caso de empate, desempata el 2º dado, y así sucesivamente.
            </li>
            <li>
              Se juega <strong>martes, miércoles y jueves</strong>. Lunes,
              viernes y fines de semana no se tira, salvo que el admin habilite
              una tirada especial ese día.
            </li>
            <li>
              Solo se puede tirar de <strong>{schedule.start}</strong> a
              <strong>{schedule.end}</strong>. A las {schedule.end} la mesa se
              cierra y el <strong class="text-primary">veredicto final</strong>
              se publica solo en Discord (si ese día nadie tiró, no se
              publica nada).
            </li>
          </ul>
        </div>

        <div
          class="bg-white border border-foreground/10 p-8 rounded-3xl shadow-lg hover-card-lift"
        >
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            <i class="fa-solid fa-calendar-week text-secondary"></i> Temporadas
          </h3>
          <ul class="space-y-3 text-foreground/80 list-disc pl-5">
            <li>
              Hacer las tareas de <strong class="text-primary">Lavar</strong>, <strong
                class="text-primary">Sacar</strong
              > o <strong class="text-primary">Poner</strong> suma <strong
                >1 punto</strong
              > en esa categoría específica.
            </li>
            <li>
              Al final de la temporada, se hace un recuento. Quien tenga <strong
                >más puntos acumulados en una tarea</strong
              >, se consagra ganador de esa categoría y queda <strong
                >exento</strong
              > de realizarla durante toda la siguiente temporada.
            </li>
            <li>
              Si estás exento de una tarea y los dados te designan para hacerla,
              ¡te salvás y pasás a no hacer nada! (No se suman puntos estando
              exento).
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Horarios y Llegadas Tarde -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-in fade-in slide-in-from-bottom-4 duration-500 delay-200 ease-out">
      <!-- Tiempos -->
      <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div
          class="relative overflow-hidden bg-white border border-secondary/30 rounded-3xl p-6 group shadow-sm hover-card-lift"
        >
          <div
            class="absolute -right-4 -bottom-4 text-secondary/10 text-8xl group-hover:scale-110 transition-transform duration-500"
          >
            <i class="fa-solid fa-stopwatch"></i>
          </div>
          <p
            class="font-bold text-secondary uppercase tracking-widest text-xs mb-2"
          >
            🎲 Tiempo de Tiración
          </p>
          <p class="text-3xl font-black text-foreground mb-2">
            {schedule.start} <span class="text-foreground/30 font-normal">a</span> {schedule.end}
          </p>
          <p class="text-sm text-foreground/70 relative z-10">
            Martes, miércoles y jueves. Fuera de ese horario la app no deja
            tirar. Si no tiraste antes del cierre, ese día no jugás.
          </p>
        </div>
        <div
          class="relative overflow-hidden bg-white border border-primary/30 rounded-3xl p-6 group shadow-sm hover-card-lift"
        >
          <div
            class="absolute -right-4 -bottom-4 text-primary/10 text-8xl group-hover:scale-110 transition-transform duration-500"
          >
            <i class="fa-solid fa-utensils"></i>
          </div>
          <p
            class="font-bold text-primary uppercase tracking-widest text-xs mb-2"
          >
            🍽️ Llevación de Platos
          </p>
          <p class="text-3xl font-black text-foreground mb-2">
            12:30 <span class="text-foreground/30 font-normal">a</span> 13:00
          </p>
          <p class="text-sm text-foreground/70 relative z-10">
            Si no llegás antes de las 13:00, no jugás.
          </p>
        </div>
      </div>

      <!-- Castigos -->
      <div
        class="bg-white border border-foreground/10 rounded-3xl p-6 flex flex-col justify-center shadow-sm hover-card-lift"
      >
        <h3 class="font-bold text-foreground mb-3 flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-primary"></i> Llegadas Tarde
        </h3>
        <p class="text-sm text-foreground/80 mb-3">
          Llegar después de las <strong>10:15</strong> sin aviso previo excluye de
          la tirada e implica <strong class="text-primary"
            >lavar los platos directamente</strong
          >.
        </p>
        <p class="text-sm text-foreground/80">
          Si llegan varios tarde, se reparten las tareas según el orden de
          llegada.
        </p>
      </div>
    </section>

    <!-- Lomito -->
    <section
      class="bg-white border border-accent/30 p-8 md:p-10 rounded-3xl shadow-lg relative overflow-hidden group animate-in fade-in slide-in-from-bottom-4 duration-500 delay-300 ease-out hover-card-lift"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent"
      >
      </div>
      <div
        class="relative z-10 text-center md:text-left flex flex-col md:flex-row items-center gap-8"
      >
        <div class="text-7xl group-hover:animate-bounce transition-all">🥪</div>
        <div>
          <h3 class="text-2xl font-black text-accent mb-2 text-balance">
            La Cláusula Lomito
          </h3>
          <p class="text-foreground/80 leading-relaxed max-w-3xl text-pretty mb-6">
            Si la tirada de dos personas es <strong>exactamente igual</strong> en
            valores y orden, las coincidencias se celebran. El contador de la app
            se reinicia a cero y <strong>LUTVIA</strong> garantiza un almuerzo de
            <strong>lomitos con papas</strong> ese mismo día. 🥪🍟
          </p>
          <div class="border-t border-accent/10 pt-6">
            <h4 class="text-xs font-bold text-accent uppercase tracking-widest mb-3 flex items-center gap-2">
              <i class="fa-solid fa-chart-simple"></i> Probabilidad del Milagro (Para 10 jugadores, 3 tiradas por semana)
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="bg-accent/5 p-4 rounded-bloque border border-accent/10">
                <p class="text-xs text-foreground/50 font-medium">En el día (1 tirada)</p>
                <p class="text-2xl font-black text-foreground mt-1">3,42%</p>
              </div>
              <div class="bg-accent/5 p-4 rounded-bloque border border-accent/10">
                <p class="text-xs text-foreground/50 font-medium">En el mes (~13 tiradas)</p>
                <p class="text-2xl font-black text-foreground mt-1">36,40%</p>
              </div>
              <div class="bg-accent/5 p-4 rounded-bloque border border-accent/10 bg-gradient-to-br from-accent/5 to-accent/10">
                <p class="text-xs text-foreground/50 font-medium">En el año (~156 tiradas)</p>
                <p class="text-2xl font-black text-accent mt-1">99,56%</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <p class="text-center text-sm text-foreground/40 pb-8">
      <i class="fa-solid fa-microchip"></i> Las tiradas en esta app son aleatorias,
      inmutables y en tiempo real.
    </p>
  </div>
</Layout>
