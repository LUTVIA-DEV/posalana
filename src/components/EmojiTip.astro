---
// Emoji con tooltip (🍑 «va de culo», 🚫 «dado al piso»): se abre con el mouse sobre el emoji,
// con el foco (Tab) o tocándolo en el celu, y se cierra con Esc. Queda alineado a la derecha
// del emoji para no salirse de las filas, que tienen los dados contra el borde derecho.
export interface Props {
    emoji: string;
    title: string;
    text: string;
    /** Color del borde del tooltip (tokens de lutvia-ds) */
    tone?: "accent" | "amarillo";
}

const { emoji, title, text, tone = "accent" } = Astro.props;
const border = tone === "amarillo" ? "border-lutvia-amarillo/60" : "border-accent/30";
const ring = tone === "amarillo" ? "focus-visible:ring-lutvia-amarillo" : "focus-visible:ring-accent";
---

<span tabindex="0" role="img" aria-label={`${title}. ${text}`} onkeydown="if (event.key === 'Escape') this.blur()" class={`group/tip relative inline-flex leading-none cursor-help rounded-[0.3em] focus-visible:outline-none focus-visible:ring-2 ${ring}`}>
    <span aria-hidden="true">{emoji}</span>
    <span aria-hidden="true" class={`invisible opacity-0 group-hover/tip:visible group-hover/tip:opacity-100 group-focus/tip:visible group-focus/tip:opacity-100 transition-opacity duration-200 absolute z-20 top-full right-0 mt-2 w-56 bg-white border ${border} rounded-chico shadow-lg p-3 text-left whitespace-normal pointer-events-none`}>
        <span class="block text-xs font-black text-foreground mb-1">{emoji} {title}</span>
        <span class="block text-[11px] text-foreground/70 leading-snug text-pretty">{text}</span>
    </span>
</span>
