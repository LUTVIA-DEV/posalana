---
// Badges del podio: 🚫 (se le cayó un dado al piso) y 🍑 (fue de culo), centrados abajo de la
// foto de perfil y un poco encima de ella. El 🍑 va siempre último (a la derecha).
// Va adentro del contenedor `relative` de la foto.
import EmojiTip from "./EmojiTip.astro";

export interface Props {
    vaDeCulo?: boolean;
    dropped?: boolean;
}

const { vaDeCulo = false, dropped = false } = Astro.props;
// Cada badge centra su emoji con grid; pointer-events vuelve a prenderse para el tooltip
const badge = "pointer-events-auto grid place-items-center w-6 h-6 rounded-pildora bg-white shadow-md text-sm";
---

{(vaDeCulo || dropped) && (
    <span class="absolute inset-x-0 -bottom-2 z-10 flex justify-center items-center gap-0.5 pointer-events-none">
        {dropped && (
            <span class={`${badge} border border-lutvia-amarillo/60`}>
                <EmojiTip emoji="🚫" title="Se le cayó un dado al piso" text="Su primer tiro no valió: tuvo que tirar de nuevo y cuenta el que se ve." tone="amarillo" align="center" />
            </span>
        )}
        {vaDeCulo && (
            <span class={`${badge} border border-accent/30`}>
                <EmojiTip class="-translate-y-[0.5px]" emoji="🍑" title="Fue de culo" text="Cantó «va de culo» antes de tirar: cada dado se lee por la cara de abajo." align="center" />
            </span>
        )}
    </span>
)}
