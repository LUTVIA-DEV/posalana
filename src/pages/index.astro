---
import Layout from '../layouts/Layout.astro';
import db from '../db/index.js';
import { getSeasonId, getExemptionsForSeason } from '../utils/season.js';
import UserAvatar from '../components/UserAvatar.astro';
import DiceDisplay from '../components/DiceDisplay.astro';
import ScheduleNotice from '../components/ScheduleNotice.astro';
import { formatDate } from '../utils/date.js';
import { normalizeRoll } from '../utils/dice.js';
import { devUnlimitedRolls } from '../utils/dev.js';
import { getDropsForDate } from '../utils/drop.js';
import DroppedDice from '../components/DroppedDice.astro';
import { getArgentinaNow, getNextPlayDay, getRollSchedule, getRollWindowStatus, SCHEDULE_NOTICE_UNTIL } from '../utils/schedule.js';

if (!Astro.locals.user) {
	return Astro.redirect('/login');
}

const user = Astro.locals.user;

// Fecha y horario de tirada en GMT-3
const now = getArgentinaNow();
const dateStr = now.dateStr;
const schedule = await getRollSchedule(db);
const windowStatus = getRollWindowStatus(schedule, now.minutes, dateStr);
const nextPlay = getNextPlayDay(schedule, dateStr);
// Modo desarrollo (DEV_UNLIMITED_ROLLS=1, solo en local): se tira siempre y las veces que quieras
const unlimitedRolls = devUnlimitedRolls();
const canRoll = windowStatus === 'open' || user.role === 'tester' || unlimitedRolls;
const showScheduleNotice = dateStr <= SCHEDULE_NOTICE_UNTIL;

// Check if user rolled
const userRollRes = await db.execute({
    sql: "SELECT * FROM roll WHERE user_id = ? AND date = ?",
    args: [user.id, dateStr]
});
const hasRolled = userRollRes.rows.length > 0;
const myRoll = hasRolled ? normalizeRoll(userRollRes.rows[0]) : null;

// Get all rolls for today, ordered by rules
const allRollsRes = await db.execute({
    sql: `
        SELECT r.*, u.username, u.display_name, u.avatar_url 
        FROM roll r
        JOIN user u ON r.user_id = u.id
        WHERE r.date = ?
    `,
    args: [dateStr]
});
// Tiro definitivo (con «va de culo» ya aplicado); el orden lo da assignDailyChores
const allRolls = allRollsRes.rows.map(normalizeRoll);

// «Se cayeron los dados al piso» 🫣: los tiros invalidados de hoy (pueden ser varios) y si uno fue el tuyo
const todayDrops = await getDropsForDate(db, dateStr);
const rolledUserIds = new Set(allRolls.map(r => String(r.user_id)));
const myDrop = todayDrops.find(d => String(d.user_id) === String(user.id)) ?? null;
// Recién se cayó (venís del redirect de /api/roll): el dado se cae con animación
const justDropped = !!myDrop && !hasRolled && Astro.url.searchParams.get('caida') === '1';
const dropDice = (d: (typeof todayDrops)[number]) => [d.die1, d.die2, d.die3, d.die4] as number[];
// Props de DiceDisplay para mostrar el tiro caído de un jugador (igual que «va de culo»)
const dropByUser = new Map(todayDrops.map(d => [String(d.user_id), d]));
const dropProps = (userId: unknown) => {
    const d = dropByUser.get(String(userId));
    return d ? { dropped: dropDice(d), droppedVaDeCulo: d.va_de_culo } : {};
};
// Caídas que todavía esperan el re-tiro (esas no tienen fila en el ranking)
const pendingDrops = todayDrops.filter(d => !rolledUserIds.has(String(d.user_id)));

const chores = [
    { label: "Lava los platos", code: "LA", emoji: "🧽" },
    { label: "Saca la mesa", code: "SA", emoji: "🧹" },
    { label: "Pone la mesa", code: "PO", emoji: "🍴" }
];
const safeChore = { label: "Nada", code: "NA", emoji: "🎉" };

import { assignDailyChores } from '../utils/chores.js';

// Fetch exemptions
const seasonId = getSeasonId(dateStr);
const exemptions = await getExemptionsForSeason(db, seasonId);

const { rollChoreMap, lomitoActivated, lomitoPlayers, sortedRolls } = assignDailyChores(allRolls, exemptions);

const assignedLA = sortedRolls.find(r => rollChoreMap.get(r.id)?.code === 'LA');
const assignedSA = sortedRolls.find(r => rollChoreMap.get(r.id)?.code === 'SA');
const assignedPO = sortedRolls.find(r => rollChoreMap.get(r.id)?.code === 'PO');
const savedPlayers = sortedRolls.filter(r => rollChoreMap.get(r.id)?.code === 'NA');
---
<Layout>
    <div class="space-y-10 animate-in fade-in duration-500 ease-out">
        
        <!-- Podium Section -->
        <div id="podium-container">
            {allRolls.length >= 3 && (
                <section class="bg-white border border-foreground/10 p-4 sm:p-6 md:p-8 rounded-3xl shadow-xl overflow-hidden relative group animate-in fade-in slide-in-from-bottom-4 duration-500 delay-75 ease-out hover-card-lift">
            <!-- Decorative background blurs -->
            <div class="absolute -top-12 -left-12 w-36 h-36 bg-accent/5 rounded-pildora blur-2xl group-hover:bg-accent/10 transition-all duration-500 pointer-events-none"></div>
            <div class="absolute -bottom-12 -right-12 w-36 h-36 bg-secondary/5 rounded-pildora blur-2xl group-hover:bg-secondary/10 transition-all duration-500 pointer-events-none"></div>

            <div class="text-center mb-6">
                <h3 class="text-2xl font-black text-foreground tracking-tight flex items-center justify-center gap-2">
                    <i class="fa-solid fa-scroll text-accent"></i> Veredicto de Tareas
                </h3>
                <p class="text-xs text-foreground/50 mt-1 font-medium">El podio de la mala suerte: los designados para la lavación, sacación y ponición de mesa de hoy.</p>
                      <!-- Podium Layout -->
            <div class="flex items-end justify-center gap-2 sm:gap-6 pt-8 pb-4 max-w-2xl mx-auto">
                
                <!-- Left Column: PO (Pone la mesa) -->
                <div class="flex flex-col items-center flex-1 animate-float delay-100">
                    {assignedPO ? (
                        <div class="flex flex-col items-center mb-3 text-center animate-in fade-in slide-in-from-bottom-2 duration-500 w-full">
                            <div class="relative group cursor-pointer">
                                <UserAvatar user={{ username: assignedPO.username, display_name: assignedPO.display_name, avatar_url: assignedPO.avatar_url }} size="lg" border={true} />
                            </div>

                            <!-- Dice Roll -->
                            <div class="mt-2 flex justify-center">
                                <DiceDisplay die1={assignedPO.die1 as number} die2={assignedPO.die2 as number} die3={assignedPO.die3 as number} die4={assignedPO.die4 as number} vaDeCulo={assignedPO.va_de_culo} {...dropProps(assignedPO.user_id)} compact size="sm" color="text-primary" />
                            </div>

                            <span class="font-black text-foreground text-xs sm:text-sm mt-2 block text-center leading-tight px-1">{assignedPO.display_name}</span>
                        </div>
                    ) : (
                        <div class="flex flex-col items-center mb-3 text-center opacity-40 w-full">
                            <div class="w-16 h-16 rounded-pildora border-2 border-dashed border-foreground/30 flex items-center justify-center text-foreground/40 font-bold text-lg">?</div>
                            <span class="font-bold text-foreground/50 text-xs sm:text-sm mt-2 block">Vacante</span>
                            <span class="text-[9px] font-bold text-foreground/40 bg-foreground/5 px-2 py-0.5 rounded-pildora mt-1 whitespace-nowrap">
                                Pone la mesa
                            </span>
                        </div>
                    )}
                    <div class="w-full bg-gradient-to-t from-primary/5 to-primary/25 border-t-2 border-primary/45 rounded-t-bloque h-16 sm:h-20 flex items-center justify-center shadow-inner">
                        <span class="text-xs sm:text-sm font-black text-primary/70 select-none tracking-wider">PONE</span>
                    </div>
                </div>

                <!-- Center Column: SA (Saca la mesa) -->
                <div class="flex flex-col items-center flex-1 animate-float">
                    {assignedSA ? (
                        <div class="flex flex-col items-center mb-3 text-center animate-in fade-in slide-in-from-bottom-2 duration-500 w-full">
                            <div class="relative group cursor-pointer">
                                <UserAvatar user={{ username: assignedSA.username, display_name: assignedSA.display_name, avatar_url: assignedSA.avatar_url }} size="lg" border={true} />
                            </div>
                            
                            <!-- Dice Roll -->
                            <div class="mt-2 flex justify-center">
                                <DiceDisplay die1={assignedSA.die1 as number} die2={assignedSA.die2 as number} die3={assignedSA.die3 as number} die4={assignedSA.die4 as number} vaDeCulo={assignedSA.va_de_culo} {...dropProps(assignedSA.user_id)} compact size="sm" color="text-secondary" />
                            </div>

                            <span class="font-black text-foreground text-xs sm:text-sm mt-2 block text-center leading-tight px-1">{assignedSA.display_name}</span>
                        </div>
                    ) : (
                        <div class="flex flex-col items-center mb-3 text-center opacity-40 w-full">
                            <div class="w-16 h-16 rounded-pildora border-2 border-dashed border-foreground/30 flex items-center justify-center text-foreground/40 font-bold text-lg">?</div>
                            <span class="font-bold text-foreground/50 text-xs sm:text-sm mt-2 block">Vacante</span>
                            <span class="text-[9px] font-bold text-foreground/40 bg-foreground/5 px-2 py-0.5 rounded-pildora mt-1 whitespace-nowrap">
                                Saca la mesa
                            </span>
                        </div>
                    )}
                    <div class="w-full bg-gradient-to-t from-secondary/5 to-secondary/25 border-t-2 border-secondary/40 rounded-t-bloque h-16 sm:h-20 flex items-center justify-center shadow-inner">
                        <span class="text-xs sm:text-sm font-black text-secondary/70 select-none tracking-wider">SACA</span>
                    </div>
                </div>

                <!-- Right Column: LA (Lava los platos) -->
                <div class="flex flex-col items-center flex-1 animate-float delay-200">
                    {assignedLA ? (
                        <div class="flex flex-col items-center mb-3 text-center animate-in fade-in slide-in-from-bottom-3 duration-500 w-full">
                            <div class="relative group cursor-pointer">
                                <UserAvatar user={{ username: assignedLA.username, display_name: assignedLA.display_name, avatar_url: assignedLA.avatar_url }} size="lg" border={true} />
                            </div>

                            <!-- Dice Roll -->
                            <div class="mt-2 flex justify-center">
                                <DiceDisplay die1={assignedLA.die1 as number} die2={assignedLA.die2 as number} die3={assignedLA.die3 as number} die4={assignedLA.die4 as number} vaDeCulo={assignedLA.va_de_culo} {...dropProps(assignedLA.user_id)} compact size="sm" color="text-accent" />
                            </div>

                            <span class="font-black text-foreground text-xs sm:text-sm mt-2 block text-center leading-tight px-1">{assignedLA.display_name}</span>
                        </div>
                    ) : (
                        <div class="flex flex-col items-center mb-3 text-center opacity-40 w-full">
                            <div class="w-16 h-16 rounded-pildora border-2 border-dashed border-foreground/30 flex items-center justify-center text-foreground/40 font-bold text-lg">?</div>
                            <span class="font-bold text-foreground/50 text-xs sm:text-sm mt-2 block">Vacante</span>
                            <span class="text-[9px] font-bold text-foreground/40 bg-foreground/5 px-2 py-0.5 rounded-pildora mt-1 whitespace-nowrap">
                                Lava platos
                            </span>
                        </div>
                    )}
                    <div class="w-full bg-gradient-to-t from-accent/5 to-accent/25 border-t-2 border-accent/40 rounded-t-bloque h-16 sm:h-20 flex items-center justify-center shadow-inner">
                        <span class="text-xs sm:text-sm font-black text-accent/70 select-none tracking-wider">LAVA</span>
                    </div>
                </div>

            </div>

            <!-- Saved Players Indicator -->
            {savedPlayers.length > 0 && (
                <div class="mt-6 pt-4 border-t border-foreground/5 flex flex-col items-center justify-center gap-3">
                    <p class="text-xs font-semibold text-foreground/50 text-center sm:text-left">
                        El resto de los participantes que tiraron hoy zafaron de las tareas.
                    </p>
                    <p class="bg-foreground text-background px-3 py-1 rounded-pildora text-xs font-black uppercase tracking-wider shadow-sm select-none">
                        NADA
                    </p>
                </div>
            )}
                </section>
            )}
        </div>

        <!-- Hero Section -->
        <div id="hero-container">
        {hasRolled && myRoll ? (
            <section class="relative bg-white border border-foreground/10 p-4 md:p-6 rounded-3xl shadow-xl overflow-hidden flex flex-col sm:flex-row items-center justify-between animate-in fade-in slide-in-from-bottom-4 duration-500 delay-150 ease-out hover-card-lift">
                <div class="text-center sm:text-left mb-4 sm:mb-0">
                    <p class="text-secondary font-bold tracking-widest uppercase text-[10px] mb-1">Tirada del {formatDate(dateStr)}</p>
                    <p class="text-sm text-foreground/80 font-medium">Ya cumpliste con tu destino de hoy.</p>
                </div>
                <div class="flex items-center gap-3 bg-secondary/5 border border-secondary/20 px-4 py-2 rounded-chico shadow-inner">
                    <p class="text-xs text-secondary font-bold uppercase tracking-wider mr-2 hidden md:block">Tu Suerte:</p>
                    <DiceDisplay die1={myRoll.die1 as number} die2={myRoll.die2 as number} die3={myRoll.die3 as number} die4={myRoll.die4 as number} raw={myRoll.raw_dice} vaDeCulo={myRoll.va_de_culo} {...dropProps(user.id)} size="lg" />
                </div>
            </section>
        ) : null}
        {(!hasRolled || unlimitedRolls) && (
            <section class:list={["relative bg-white border border-foreground/10 p-8 md:p-12 rounded-3xl shadow-xl overflow-hidden text-center group animate-in fade-in slide-in-from-bottom-4 duration-500 delay-150 ease-out hover-card-lift", hasRolled && "mt-4"]}>
                <!-- Decorative Background Element -->
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-secondary/10 rounded-pildora blur-3xl group-hover:bg-secondary/20 transition-all duration-700 pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/10 rounded-pildora blur-3xl group-hover:bg-accent/20 transition-all duration-700 pointer-events-none"></div>

                <div class="relative z-10">
                    <p class="text-secondary font-bold tracking-widest uppercase text-xs mb-2">Tirada Oficial</p>
                    <h2 class="text-4xl md:text-5xl font-black mb-2 tracking-tight text-foreground text-balance">{formatDate(dateStr)}</h2>
                    {myDrop && !hasRolled && (
                        <div role={justDropped ? "alert" : undefined} class:list={["mx-auto max-w-md my-6 bg-lutvia-amarillo/15 border-2 border-lutvia-amarillo/60 rounded-bloque px-5 py-4", justDropped && "animate-in fade-in zoom-in-95 duration-300"]}>
                            <p class="text-lg font-black text-foreground tracking-tight text-balance"><span aria-hidden="true">🫣</span> ¡Se te cayó un dado al piso!</p>
                            <div class="my-3 flex justify-center">
                                <DroppedDice dice={dropDice(myDrop)} vaDeCulo={myDrop.va_de_culo} size="lg" animate={justDropped} />
                            </div>
                            <p class="text-sm text-foreground/70 font-medium text-pretty">Ese tiro no vale. Juntalo y <strong>tirá de nuevo</strong>: podés volver a elegir si va de culo.</p>
                        </div>
                    )}
                    {canRoll ? (
                    <>
                    <p class="text-foreground/60 mb-3 max-w-md mx-auto text-pretty">El destino no está escrito, se decide con los dados. ¿Zafás o lavás?</p>
                    <p class="inline-flex items-center gap-2 text-xs font-bold text-secondary bg-secondary/10 px-3 py-1 rounded-pildora mb-8">
                        <i class="fa-regular fa-clock"></i> La tirada cierra a las {schedule.end}
                    </p>

                    <form method="post" action="/api/roll" id="roll-form" class="flex flex-col items-center gap-4">
                        <button type="submit" id="roll-button" class="relative overflow-hidden bg-secondary text-background px-10 py-5 rounded-pildora text-xl font-bold shadow-[0_8px_30px_rgba(0,204,204,0.3)] hover:shadow-[0_8px_40px_rgba(0,204,204,0.5)] hover:-translate-y-1 active:translate-y-0 active:shadow-[0_4px_15px_rgba(0,204,204,0.3)] transition-all duration-300 cursor-pointer group">
                            <span class="relative z-10 flex items-center justify-center gap-3" id="roll-button-content">
                                <i class="fa-solid fa-dice text-2xl group-hover:rotate-180 transition-transform duration-500" id="roll-icon"></i>
                                <span id="roll-text">TIRAR LOS DADOS</span>
                            </span>
                            <!-- Hover gradient overlay -->
                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-background/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></div>
                        </button>
                        {unlimitedRolls && (
                            <label class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest text-foreground/40 cursor-pointer select-none">
                                <input type="checkbox" name="forzar_caida" value="1" class="accent-[var(--lutvia-oscuro)]" />
                                <i class="fa-solid fa-flask" aria-hidden="true"></i> Forzar dados al piso (dev)
                            </label>
                        )}
                        <!-- «Va de culo» 🍑: se canta antes de tirar; el servidor da vuelta los dados (7 − x) -->
                        <div class="relative inline-flex items-center gap-2 bg-white border-2 border-foreground/10 hover:border-accent/40 has-[:checked]:border-accent has-[:checked]:bg-accent/10 has-[:checked]:shadow-[0_4px_16px_rgba(204,102,255,0.25)] pl-1.5 pr-1.5 py-1.5 rounded-pildora shadow-sm transition-all duration-300">
                        <label for="va-de-culo" class="group/switch inline-flex items-center gap-2 cursor-pointer select-none">
                            <input type="checkbox" role="switch" id="va-de-culo" name="va_de_culo" value="1" aria-describedby="va-de-culo-ayuda" class="peer sr-only" />
                            <!-- Interruptor -->
                            <span aria-hidden="true" class="relative w-10 h-6 shrink-0 rounded-pildora bg-foreground/15 group-hover/switch:bg-foreground/25 peer-checked:bg-accent peer-checked:group-hover/switch:bg-accent peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 transition-colors duration-300 after:content-[''] after:absolute after:top-1 after:left-1 after:w-4 after:h-4 after:rounded-pildora after:bg-white after:shadow after:transition-transform after:duration-300 peer-checked:after:translate-x-4"></span>
                            <span class="text-sm font-black text-foreground/70 peer-checked:text-accent transition-colors tracking-tight">Va de culo</span>
                            <span aria-hidden="true" class="text-lg inline-block transition-transform duration-500 peer-checked:rotate-180">🍑</span>
                        </label>
                        <!-- Tooltip «¿Qué es?»: se abre al pasar el mouse, con el foco (Tab) o tocándolo en el celu -->
                        <div class="group/ayuda flex">
                            <button type="button" onkeydown="if (event.key === 'Escape') this.blur()" aria-label="¿Qué es «va de culo»?" aria-describedby="va-de-culo-ayuda" class="w-6 h-6 flex items-center justify-center leading-none text-[10px] rounded-pildora bg-foreground/5 text-foreground/60 hover:text-accent hover:bg-accent/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 transition-colors cursor-help">
                                <i class="fa-solid fa-question leading-none" aria-hidden="true"></i>
                            </button>
                            <div id="va-de-culo-ayuda" role="tooltip" class="invisible opacity-0 group-hover/ayuda:visible group-hover/ayuda:opacity-100 group-focus-within/ayuda:visible group-focus-within/ayuda:opacity-100 transition-opacity duration-200 absolute z-20 bottom-full left-1/2 -translate-x-1/2 mb-2 w-52 bg-white border border-accent/30 rounded-chico shadow-lg p-3 text-left">
                                <p class="text-xs font-black text-accent mb-1">Va de culo <span aria-hidden="true">🍑</span></p>
                                <p class="text-[11px] text-foreground/80 leading-snug text-pretty mb-2">Como en la generala: si la cantás <strong>antes de tirar</strong>, cada dado se lee por la cara de abajo. Cuenta el tiro dado vuelta para todo.</p>
                                <p class="flex items-center justify-center gap-1.5 text-base bg-accent/5 rounded-chico py-1.5" aria-hidden="true">
                                    <i class="fa-solid fa-dice-one text-foreground/40"></i>
                                    <i class="fa-solid fa-arrow-right text-xs text-accent"></i>
                                    <i class="fa-solid fa-dice-six text-accent"></i>
                                    <span class="w-2"></span>
                                    <i class="fa-solid fa-dice-two text-foreground/40"></i>
                                    <i class="fa-solid fa-arrow-right text-xs text-accent"></i>
                                    <i class="fa-solid fa-dice-five text-accent"></i>
                                </p>
                                <p class="text-[10px] text-foreground/60 mt-2 text-pretty">¿Da más suerte? Ni un poquito. Es pura cábala.</p>
                            </div>
                        </div>
                        </div>
                    </form>
                    </>
                    ) : windowStatus === 'no-play' ? (
                    <>
                        <p class="text-foreground/60 mb-8 max-w-md mx-auto text-pretty">Hoy los dados descansan: se juega martes, miércoles y jueves.</p>
                        <div class="inline-flex flex-col items-center gap-1 bg-foreground/5 border border-foreground/10 px-8 py-5 rounded-bloque">
                            <span class="text-xs font-bold uppercase tracking-widest text-foreground/50"><i class="fa-solid fa-mug-hot mr-1"></i> Hoy no se juega</span>
                            <span class="block text-2xl font-black text-foreground first-letter:uppercase">{nextPlay.label}</span>
                            <span class="text-xs text-foreground/50 font-medium">es la próxima tirada, de {schedule.start} a {schedule.end}</span>
                        </div>
                    </>
                    ) : windowStatus === 'before' ? (
                    <>
                        <p class="text-foreground/60 mb-8 max-w-md mx-auto text-pretty">Los dados todavía están guardados. Paciencia, que el destino tiene horario.</p>
                        <div class="inline-flex flex-col items-center gap-1 bg-foreground/5 border border-foreground/10 px-8 py-5 rounded-bloque">
                            <span class="text-xs font-bold uppercase tracking-widest text-foreground/50"><i class="fa-solid fa-lock mr-1"></i> La tirada abre a las</span>
                            <span class="text-4xl font-black text-foreground">{schedule.start}</span>
                            <span class="text-xs text-foreground/50 font-medium">y cierra a las {schedule.end}</span>
                        </div>
                    </>
                    ) : (
                    <>
                        <p class="text-foreground/60 mb-8 max-w-md mx-auto text-pretty">La mesa está cerrada y el veredicto final ya es definitivo. Si no tiraste, hoy no jugás.</p>
                        <div class="inline-flex flex-col items-center gap-1 bg-primary/5 border border-primary/20 px-8 py-5 rounded-bloque">
                            <span class="text-xs font-bold uppercase tracking-widest text-primary"><i class="fa-solid fa-door-closed mr-1"></i> Tirada cerrada a las {schedule.end}</span>
                            <span class="text-sm text-foreground/60 font-medium">Volvé {nextPlay.label} de {schedule.start} a {schedule.end}</span>
                        </div>
                    </>
                    )}
                    {unlimitedRolls && (
                        <p class="mt-6 text-[10px] font-bold uppercase tracking-widest text-foreground/40"><i class="fa-solid fa-flask mr-1" aria-hidden="true"></i> Modo desarrollo: tiradas sin límite</p>
                    )}
                </div>
            </section>
        )}
        </div>

        <!-- Cláusula Lomito -->
        <div id="lomito-container">
            {lomitoActivated && (
                <>
                    <section class="bg-white border-2 border-accent/60 p-8 rounded-3xl shadow-lg shadow-accent/10 text-center relative overflow-hidden animate-in zoom-in-95 duration-500">
                        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjIiIGZpbGw9IiNDQzY2RkYiIGZpbGwtb3BhY2l0eT0iMC4xIi8+PC9zdmc+')] opacity-50"></div>
                        <div class="relative z-10">
                            <p class="text-5xl mb-4 animate-bounce">🥪🎉🥪</p>
                            <h3 class="text-2xl md:text-3xl font-black text-accent mb-2 tracking-tight text-balance">¡CLÁUSULA LOMITO ACTIVADA!</h3>
                            <p class="text-accent/90 text-lg md:text-xl font-semibold mb-1 text-pretty">{lomitoPlayers.join(" y ")} rompieron la matrix.</p>
                            <p class="text-foreground/70 font-medium text-pretty">Sus dados son idénticos. ¡Hoy se almuerzan lomitos con papas!</p>
                        </div>
                    </section>
                    <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
                    <script is:inline>
                        // Lanza confetti durante 5 segundos
                        const duration = 5 * 1000;
                        const animationEnd = Date.now() + duration;
                        const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 100 };

                        function randomInRange(min, max) {
                            return Math.random() * (max - min) + min;
                        }

                        const interval = setInterval(function() {
                            const timeLeft = animationEnd - Date.now();

                            if (timeLeft <= 0) {
                                return clearInterval(interval);
                            }

                            const particleCount = 50 * (timeLeft / duration);
                            confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                            confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
                        }, 250);
                    </script>
                </>
            )}
        </div>

        <!-- Ranking Section -->
        <section id="ranking-container" class="bg-white border border-foreground/10 p-4 sm:p-6 md:p-10 rounded-3xl shadow-xl animate-in fade-in slide-in-from-bottom-4 duration-500 delay-300 ease-out hover-card-lift">
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-foreground/5">
                <h3 class="text-2xl font-black tracking-tight text-foreground flex items-center gap-3 text-balance">
                    <i class="fa-solid fa-trophy text-secondary"></i> Ranking POSALANA
                </h3>
            </div>
            {pendingDrops.length > 0 && (
                <ul class="-mt-4 mb-6 flex flex-col gap-1 text-sm text-foreground/60 font-medium bg-lutvia-amarillo/10 border border-lutvia-amarillo/40 rounded-chico px-4 py-2">
                    {pendingDrops.map(d => (
                        <li class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <span><span aria-hidden="true">🫣</span> A <strong class="text-foreground">{d.display_name || d.username}</strong> se le cayeron los dados: tiene que tirar de nuevo</span>
                            <DroppedDice dice={dropDice(d)} vaDeCulo={d.va_de_culo} size="sm" />
                        </li>
                    ))}
                </ul>
            )}
            
            {allRolls.length === 0 ? (
                <div class="py-16 text-center border-2 border-dashed border-foreground/10 rounded-bloque">
                    <div class="text-4xl mb-4 text-foreground/20"><i class="fa-solid fa-ghost"></i></div>
                    <p class="text-foreground/50 font-medium text-lg">Nadie se ha atrevido a tirar todavía.</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 gap-4">
                    {sortedRolls.map((roll, index) => {
                        const chore = rollChoreMap.get(roll.id) || safeChore;
                        const code = chore.code as 'PO' | 'SA' | 'LA' | 'NA';
                        const isSafe = code === "NA";
                        const isMe = String(roll.user_id) === String(user.id);
                        const userExemptions = exemptions.filter(e => String(e.user_id) === String(roll.user_id));
                        
                        const colorConfig = {
                            PO: {
                                bg: isMe ? 'bg-primary/15 border-primary/45 ring-1 ring-primary/30 shadow-md scale-[1.01]' : 'bg-primary/8 border-primary/15 hover:border-primary/45',
                                badge: 'bg-primary text-background',
                                text: 'text-primary font-bold',
                                diceColor: 'text-primary'
                            },
                            SA: {
                                bg: isMe ? 'bg-secondary/15 border-secondary/45 ring-1 ring-secondary/30 shadow-md scale-[1.01]' : 'bg-secondary/8 border-secondary/15 hover:border-secondary/45',
                                badge: 'bg-secondary text-background',
                                text: 'text-secondary font-bold',
                                diceColor: 'text-secondary'
                            },
                            LA: {
                                bg: isMe ? 'bg-accent/15 border-accent/45 ring-1 ring-accent/30 shadow-md scale-[1.01]' : 'bg-accent/8 border-accent/15 hover:border-accent/45',
                                badge: 'bg-accent text-background',
                                text: 'text-accent font-bold',
                                diceColor: 'text-accent'
                            },
                            NA: {
                                bg: isMe ? 'bg-foreground/5 border-foreground/20 ring-1 ring-foreground/10 shadow-sm' : 'bg-foreground/[0.02] border-foreground/5 hover:border-foreground/15',
                                badge: 'bg-foreground/10 text-foreground/50 border border-foreground/5',
                                text: 'text-foreground/40 font-medium',
                                diceColor: 'text-foreground/30'
                            }
                        };
                        
                        const config = colorConfig[code] || colorConfig.NA;
                        
                        return (
                            <div class={`group flex flex-col sm:flex-row sm:items-center justify-between p-5 rounded-chico border transition-all duration-300 hover:shadow-md ${config.bg}`}>
                                
                                <!-- User Info & Time -->
                                <div class="flex items-center gap-4 mb-4 sm:mb-0 w-full sm:w-auto">
                                    <UserAvatar user={roll as any} size="lg" border={true} />
                                    <div class="flex-grow">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <p class="font-black text-foreground text-xl leading-tight">{roll.display_name}</p>
                                            {isMe && (
                                                <span class="inline-flex items-center gap-1 text-[9px] font-black tracking-wider uppercase bg-foreground text-background px-2 py-0.5 rounded-pildora select-none">
                                                    <i class="fa-solid fa-circle-user text-[8px]"></i> Vos
                                                </span>
                                            )}
                                            <span class={`inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-pildora ${config.badge}`}>
                                                {chore.code}
                                            </span>
                                            {userExemptions.map(ex => {
                                                const targetChore = chores.find(c => c.code === ex.chore_code);
                                                const choreLabel = targetChore ? targetChore.label.split(' ')[0] : ex.chore_code;
                                                return (
                                                    <span class="inline-flex items-center gap-1 text-[9px] font-black tracking-wider uppercase bg-accent/10 text-accent border border-accent/20 px-2 py-0.5 rounded-chico" title={`Exento de: ${targetChore ? targetChore.label : ex.chore_code}`}>
                                                        <i class="fa-solid fa-shield-halved text-[8px]"></i> Exento {choreLabel}
                                                    </span>
                                                )
                                            })}
                                        </div>
                                        {roll.time && <span class="text-xs tabular-nums text-foreground/40 bg-foreground/5 px-2 py-0.5 rounded-chico"><i class="fa-regular fa-clock"></i> {roll.time}</span>}
                                        <div class={`font-bold mt-1 text-sm ${config.text} whitespace-nowrap`}>
                                            {chore.emoji} {chore.label}
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center justify-center sm:justify-end bg-white/50 sm:bg-transparent p-4 sm:p-0 rounded-chico w-full sm:w-auto mt-2 sm:mt-0">
                                    <DiceDisplay die1={roll.die1 as number} die2={roll.die2 as number} die3={roll.die3 as number} die4={roll.die4 as number} raw={roll.raw_dice} vaDeCulo={roll.va_de_culo} {...dropProps(roll.user_id)} size="xl" color={config.diceColor} />
                                </div>
                            </div>
                        )
                    })}
                </div>
            )}
        </section>

        <!-- Client-side Polling Script & Roll Animation -->
        <script is:inline>
            (function() {
                const POLL_INTERVAL = 8000;
                let intervalId = null;

                async function checkUpdates() {
                    try {
                        const response = await fetch(window.location.href, { cache: 'no-cache' });
                        if (!response.ok) return;
                        
                        const text = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(text, "text/html");

                        // 1. Update Ranking
                        const newRanking = doc.getElementById("ranking-container");
                        const oldRanking = document.getElementById("ranking-container");
                        if (newRanking && oldRanking && newRanking.innerHTML !== oldRanking.innerHTML) {
                            oldRanking.innerHTML = newRanking.innerHTML;
                        }

                        // 2. Update Podium
                        const newPodium = doc.getElementById("podium-container");
                        const oldPodium = document.getElementById("podium-container");
                        if (newPodium && oldPodium && newPodium.innerHTML !== oldPodium.innerHTML) {
                            oldPodium.innerHTML = newPodium.innerHTML;
                        }

                        // 3. Update Hero (abre/cierra la tirada según el horario)
                        const newHero = doc.getElementById("hero-container");
                        const oldHero = document.getElementById("hero-container");
                        const rollingNow = document.getElementById("roll-overlay")?.classList.contains("flex");
                        if (!rollingNow && newHero && oldHero && newHero.innerHTML !== oldHero.innerHTML) {
                            oldHero.innerHTML = newHero.innerHTML;
                            setupRollAnimation();
                        }

                        // 4. Update Lomito Banner and check for new Lomito activation
                        const newLomito = doc.getElementById("lomito-container");
                        const oldLomito = document.getElementById("lomito-container");
                        if (newLomito && oldLomito && newLomito.innerHTML !== oldLomito.innerHTML) {
                            const hadLomito = oldLomito.querySelector("section") !== null;
                            const hasLomito = newLomito.querySelector("section") !== null;
                            
                            oldLomito.innerHTML = newLomito.innerHTML;

                            // Trigger confetti if Lomito just got activated
                            if (!hadLomito && hasLomito) {
                                triggerConfetti();
                            }
                        }
                    } catch (error) {
                        console.error("Error checking for updates:", error);
                    }
                }

                function triggerConfetti() {
                    if (typeof window.confetti === "function") {
                        runConfetti();
                    } else {
                        const script = document.createElement("script");
                        script.src = "https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js";
                        script.onload = runConfetti;
                        document.body.appendChild(script);
                    }
                }

                function runConfetti() {
                    const duration = 5 * 1000;
                    const animationEnd = Date.now() + duration;
                    const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 100 };

                    function randomInRange(min, max) {
                        return Math.random() * (max - min) + min;
                    }

                    const interval = setInterval(() => {
                        const timeLeft = animationEnd - Date.now();
                        if (timeLeft <= 0) {
                            return clearInterval(interval);
                        }
                        const particleCount = 50 * (timeLeft / duration);
                        window.confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
                        window.confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
                    }, 250);
                }

                function startPolling() {
                    if (!intervalId) {
                        intervalId = setInterval(checkUpdates, POLL_INTERVAL);
                    }
                }

                function stopPolling() {
                    if (intervalId) {
                        clearInterval(intervalId);
                        intervalId = null;
                    }
                }

                function handleVisibilityChange() {
                    if (document.hidden) {
                        stopPolling();
                    } else {
                        checkUpdates();
                        startPolling();
                    }
                }

                // «Va de culo» 🍑: después de sacudirse, los dados se frenan y se dan vuelta uno por uno
                // (cada uno gira y muestra su cara opuesta, 7 − x) mientras el durazno da una vuelta.
                // Con prefers-reduced-motion no hay giros: las caras cambian de una y listo.
                function playVaDeCulo(overlay, diceIcons, diceWords, faceChangeInterval, statusText, submit) {
                    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    const kicker = document.getElementById('overlay-kicker');
                    const peach = document.getElementById('overlay-culo');
                    const setFace = (icon, value) => {
                        diceWords.forEach(word => icon.classList.remove(`fa-dice-${word}`));
                        icon.classList.add(`fa-dice-${diceWords[value - 1]}`);
                    };

                    if (kicker) {
                        kicker.textContent = '¡Cantó va de culo!';
                        kicker.classList.replace('text-secondary', 'text-accent');
                    }
                    const subtitle = document.getElementById('overlay-subtitle');
                    if (subtitle) subtitle.textContent = 'Cada dado se lee por la cara de abajo. ¡Que la cábala te acompañe!';
                    if (peach) {
                        peach.classList.remove('hidden');
                        peach.classList.add('inline-block');
                        if (!reduce) {
                            peach.animate([
                                { transform: 'scale(0) rotate(-30deg)' },
                                { transform: 'scale(1.25) rotate(10deg)', offset: 0.6 },
                                { transform: 'scale(1) rotate(0deg)' }
                            ], { duration: 500, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' });
                        }
                    }

                    // A los 1000 ms se frenan: quedan quietos con una cara cualquiera
                    setTimeout(() => {
                        clearInterval(faceChangeInterval);
                        const faces = Array.from(diceIcons, icon => {
                            icon.classList.remove('animate-shake-roll');
                            const value = Math.floor(Math.random() * 6) + 1;
                            setFace(icon, value);
                            return value;
                        });
                        if (statusText) statusText.textContent = 'Dando vuelta los dados...';

                        if (reduce) {
                            diceIcons.forEach((icon, i) => setFace(icon, 7 - faces[i]));
                            return;
                        }

                        // El durazno gira y cada dado se da vuelta: sube, gira hasta quedar de canto,
                        // cambia a la cara opuesta y termina de girar
                        peach?.animate([
                            { transform: 'rotate(0deg) scale(1)' },
                            { transform: 'rotate(180deg) scale(1.3)', offset: 0.5 },
                            { transform: 'rotate(360deg) scale(1)' }
                        ], { duration: 900, easing: 'ease-in-out' });

                        diceIcons.forEach((icon, i) => {
                            const delay = 150 + i * 160;
                            icon.animate([
                                { transform: 'translateY(0) rotateX(0deg)' },
                                { transform: 'translateY(-28px) rotateX(90deg)' }
                            ], { duration: 220, delay, easing: 'ease-in', fill: 'forwards' }).onfinish = () => {
                                setFace(icon, 7 - faces[i]);
                                icon.animate([
                                    { transform: 'translateY(-28px) rotateX(-90deg)' },
                                    { transform: 'translateY(0) rotateX(0deg)' }
                                ], { duration: 320, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)', fill: 'forwards' });
                            };
                        });
                    }, 1000);

                    setTimeout(() => {
                        if (statusText) statusText.textContent = '¡Fue de culo!';
                    }, 2150);

                    setTimeout(submit, reduce ? 1800 : 2700);
                }

                function setupRollAnimation() {
                    const rollForm = document.getElementById('roll-form');
                    const rollButton = document.getElementById('roll-button');
                    const rollOverlay = document.getElementById('roll-overlay');
                    const overlayStatusText = document.getElementById('overlay-status-text');

                    if (rollForm && rollButton && rollOverlay) {
                        rollForm.addEventListener('submit', (e) => {
                            e.preventDefault();
                            
                            // Show full-screen overlay
                            rollOverlay.classList.remove('hidden');
                            rollOverlay.classList.add('flex');
                            
                            // Disable button
                            rollButton.disabled = true;
                            rollButton.classList.add('opacity-50', 'cursor-not-allowed');
                            
                            // Animate overlay dice faces
                            const diceIcons = rollOverlay.querySelectorAll('#overlay-dice i');
                            const diceWords = ['one', 'two', 'three', 'four', 'five', 'six'];
                            
                            const faceChangeInterval = setInterval(() => {
                                diceIcons.forEach(icon => {
                                    diceWords.forEach(word => icon.classList.remove(`fa-dice-${word}`));
                                    const randomVal = Math.floor(Math.random() * 6);
                                    icon.classList.add(`fa-dice-${diceWords[randomVal]}`);
                                });
                            }, 60);

                            // Change status texts for suspense
                            setTimeout(() => {
                                if (overlayStatusText) overlayStatusText.textContent = 'Calculando trayectorias...';
                            }, 500);

                            const vaDeCulo = document.getElementById('va-de-culo')?.checked;
                            if (vaDeCulo) {
                                playVaDeCulo(rollOverlay, diceIcons, diceWords, faceChangeInterval, overlayStatusText, () => rollForm.submit());
                                return;
                            }

                            setTimeout(() => {
                                if (overlayStatusText) overlayStatusText.textContent = 'Escribiendo el destino...';
                            }, 1000);

                            // Submit form after 1.5 seconds
                            setTimeout(() => {
                                clearInterval(faceChangeInterval);
                                rollForm.submit();
                            }, 1500);
                        });
                    }
                }

                // Initialize under View Transitions lifecycle
                document.addEventListener('astro:page-load', () => {
                    stopPolling();
                    setupRollAnimation();
                    
                    document.addEventListener("visibilitychange", handleVisibilityChange);
                    if (!document.hidden) {
                        startPolling();
                    }
                });

                document.addEventListener('astro:before-preparation-change', () => {
                    stopPolling();
                    document.removeEventListener("visibilitychange", handleVisibilityChange);
                });
            })();
        </script>
        
        {showScheduleNotice && <ScheduleNotice start={schedule.start} end={schedule.end} dateStr={dateStr} />}

        <!-- Fullscreen Dice Rolling Overlay -->
        <div id="roll-overlay" class="fixed inset-0 z-[100] bg-background/80 backdrop-blur-md hidden flex-col items-center justify-center animate-in fade-in duration-300">
            <div class="bg-white/80 border border-white/20 p-8 sm:p-12 rounded-3xl shadow-2xl flex flex-col items-center gap-8 max-w-md w-[90%] text-center animate-in zoom-in-95 duration-300">
                <p id="overlay-kicker" class="text-secondary font-black tracking-widest uppercase text-sm animate-pulse">Invocando al destino</p>

                <!-- «Va de culo»: el 🍑 aparece solo si se cantó (lo anima setupRollAnimation) -->
                <span id="overlay-culo" class="hidden text-6xl leading-none -mb-4" aria-hidden="true">🍑</span>

                <!-- Giant Rolling Dice Container -->
                <div id="overlay-dice" class="flex items-center justify-center gap-6 text-5xl sm:text-6xl md:text-7xl py-4" style="perspective: 600px;">
                    <i class="fa-solid fa-dice-one text-primary animate-shake-roll" style="animation-delay: 0s;"></i>
                    <i class="fa-solid fa-dice-two text-secondary animate-shake-roll" style="animation-delay: 0.1s;"></i>
                    <i class="fa-solid fa-dice-three text-accent animate-shake-roll" style="animation-delay: 0.2s;"></i>
                    <i class="fa-solid fa-dice-four text-foreground/40 animate-shake-roll" style="animation-delay: 0.3s;"></i>
                </div>
                
                <div class="space-y-2">
                    <h3 class="text-2xl font-black text-foreground tracking-tight" id="overlay-status-text">Lanzando los dados...</h3>
                    <p id="overlay-subtitle" class="text-xs text-foreground/50 font-medium">¿Zafás o lavás? El destino se está decidiendo ahora mismo.</p>
                </div>
                
                <!-- Glowing loading bar -->
                <div class="w-full bg-foreground/5 h-2 rounded-pildora overflow-hidden">
                    <div class="bg-gradient-to-r from-primary via-secondary to-accent h-full w-full rounded-pildora animate-pulse"></div>
                </div>
            </div>
        </div>
    </div>
</Layout>
