---
import db from "../db/index.js";
import UserAvatar from "./UserAvatar.astro";
import { formatDate } from "../utils/date.js";

const { user } = Astro.locals;

// Calculate days without lomito
const today = new Date();
today.setHours(today.getHours() - 3);
const todayStr = today.toISOString().split('T')[0];

const lastLomitoRes = await db.execute(`
	SELECT date
	FROM roll
	GROUP BY date, die1, die2, die3, die4
	HAVING COUNT(*) > 1
	ORDER BY date DESC
	LIMIT 1
`);

const autoLomitoDate = lastLomitoRes.rows.length > 0 ? lastLomitoRes.rows[0].date as string : null;

const settingsRes = await db.execute("SELECT value FROM settings WHERE key = 'last_lomito_date'");
const manualLomitoDate = settingsRes.rows.length > 0 ? settingsRes.rows[0].value as string : null;

let lastLomitoDate = manualLomitoDate ? manualLomitoDate : autoLomitoDate;

let daysSinceLomito: number | null = null;
let lomitoTooltip = "Nunca hubo un lomito aún 😢";

if (lastLomitoDate) {
	const last = new Date(lastLomitoDate + "T12:00:00");
	const now = new Date(todayStr + "T12:00:00");
	daysSinceLomito = Math.floor((now.getTime() - last.getTime()) / (1000 * 60 * 60 * 24));
	lomitoTooltip = `Último lomito: ${formatDate(lastLomitoDate)}`;
}
---

<!-- Sticky Header -->
<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md shadow-sm border-b border-foreground/5 transition-all duration-300">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-4 flex justify-between items-center">
        <!-- Brand & Lomito -->
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-black tracking-tighter origin-left">
                <a href="/" class="flex logo-container">
                    <span class="text-primary logo-syllable syllable-1">PO</span>
                    <span class="text-secondary logo-syllable syllable-2">SA</span>
                    <span class="text-accent logo-syllable syllable-3">LA</span>
                    <span class="text-foreground logo-syllable syllable-4">NA</span>
                </a>
            </h1>
            
            <div class="relative group hidden sm:block">
                <span data-lomito-badge class="inline-block text-xs font-bold bg-accent/10 text-accent px-3 py-1 rounded-pildora cursor-default select-none shadow-sm border border-accent/20">
                    🥪 {daysSinceLomito !== null ? daysSinceLomito : "∞"} {daysSinceLomito === 1 ? 'día' : 'días'} sin lomito
                </span>
                <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 bg-foreground/90 backdrop-blur-sm text-background text-xs px-3 py-2 rounded-chico shadow-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-50 translate-y-1 group-hover:translate-y-0">
                    {lomitoTooltip}
                </div>
            </div>
        </div>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center space-x-6 text-sm font-semibold">
            <a href="/" class="text-foreground/80 hover:text-secondary transition-colors relative after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-secondary hover:after:w-full after:transition-all after:duration-300">Inicio</a>
            <a href="/history" class="text-foreground/80 hover:text-secondary transition-colors relative after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-secondary hover:after:w-full after:transition-all after:duration-300">Historial</a>
            <a href="/rules" class="text-foreground/80 hover:text-secondary transition-colors relative after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-secondary hover:after:w-full after:transition-all after:duration-300">Reglas</a>
            
            {user ? (
                <div class="flex items-center gap-4 pl-4 border-l border-foreground/10">
                    <div class="flex items-center gap-2">
                        <a href="/profile" class="text-foreground font-bold flex items-center gap-2 hover:text-secondary transition-colors group">
                            <i class="fa-solid fa-user-circle text-secondary group-hover:scale-110 transition-transform"></i> {user.display_name || user.username}
                        </a>
                        {user.role === 'admin' && (
                            <a href="/admin" class="bg-primary/10 text-primary text-[10px] uppercase tracking-wider px-2 py-1 rounded-chico hover:bg-primary/20 transition-colors">Admin</a>
                        )}
                    </div>
                    <form method="post" action="/api/logout">
                        <button class="text-primary/80 hover:text-primary font-bold hover:bg-primary/10 px-3 py-1.5 rounded-pildora transition-colors cursor-pointer"><i class="fa-solid fa-arrow-right-from-bracket"></i></button>
                    </form>
                </div>
            ) : (
                <a href="/login" class="bg-secondary text-background px-5 py-2 rounded-pildora hover:shadow-lg hover:shadow-secondary/30 hover:-translate-y-0.5 transition-all">Iniciar Sesión</a>
            )}
        </nav>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-foreground/80 hover:text-foreground text-2xl transition-transform active:scale-95 cursor-pointer">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
    
    <!-- Mobile Lomito Indicator -->
    <div class="sm:hidden px-4 pb-3 border-t border-foreground/5 flex justify-center bg-white/50">
        <span data-lomito-badge class="inline-block text-xs font-bold bg-accent/10 text-accent px-3 py-1 rounded-pildora cursor-default select-none mt-2">
            🥪 {daysSinceLomito !== null ? daysSinceLomito : "∞"} {daysSinceLomito === 1 ? 'día' : 'días'} sin lomito ({lomitoTooltip})
        </span>
    </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-white flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out md:hidden pt-20">
    <nav class="flex flex-col space-y-2 p-6 text-xl font-bold">
        <a href="/" class="mobile-link p-4 rounded-chico text-foreground hover:bg-foreground/5 transition-colors border-b border-foreground/5"><i class="fa-solid fa-home w-8 text-secondary"></i> Inicio</a>
        <a href="/history" class="mobile-link p-4 rounded-chico text-foreground hover:bg-foreground/5 transition-colors border-b border-foreground/5"><i class="fa-solid fa-clock-rotate-left w-8 text-secondary"></i> Historial</a>
        <a href="/rules" class="mobile-link p-4 rounded-chico text-foreground hover:bg-foreground/5 transition-colors border-b border-foreground/5"><i class="fa-solid fa-book w-8 text-secondary"></i> Reglas</a>
        
        {user ? (
            <div class="pt-6 mt-4 border-t border-foreground/10">
                <div class="p-4 flex items-center justify-between">
                    <a href="/profile" class="mobile-link flex items-center gap-3 group">
                        <UserAvatar user={user as any} size="sm" />
                        <div>
                            <p class="text-sm font-normal text-foreground/60 group-hover:text-secondary transition-colors">Editar Perfil</p>
                            <p class="text-foreground font-bold flex items-center gap-1.5 group-hover:text-secondary transition-colors">
                                {user.display_name || user.username} <i class="fa-solid fa-pen-to-square text-xs opacity-50"></i>
                            </p>
                        </div>
                    </a>
                    {user.role === 'admin' && (
                        <a href="/admin" class="mobile-link bg-primary/10 hover:bg-primary/20 text-primary text-xs font-black uppercase tracking-wider px-3 py-1.5 rounded-chico transition-colors">Admin</a>
                    )}
                </div>
                <form method="post" action="/api/logout" class="mt-2">
                    <button class="w-full text-left p-4 rounded-chico text-primary hover:bg-primary/5 transition-colors font-bold cursor-pointer"><i class="fa-solid fa-arrow-right-from-bracket w-8"></i> Cerrar Sesión</button>
                </form>
            </div>
        ) : (
            <div class="pt-6 mt-4 border-t border-foreground/10">
                <a href="/login" class="mobile-link flex items-center justify-center w-full bg-secondary text-background p-4 rounded-chico font-bold shadow-lg shadow-secondary/20"><i class="fa-solid fa-right-to-bracket mr-2"></i> Iniciar Sesión</a>
            </div>
        )}
    </nav>
</div>

<!-- Easter egg: muchos clicks en el badge de días sin lomito desatan una lluvia de lomitos -->
<script>
    if (!(window as any).__lomitoRainInit) {
        (window as any).__lomitoRainInit = true;

        const CLICKS_NEEDED = 7;
        const WINDOW_MS = 3000;
        let clicks: number[] = [];
        let raining = false;

        const makeItRain = () => {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const count = reduceMotion ? 15 : 70;
            const perFrame = 10;

            const layer = document.createElement('div');
            layer.setAttribute('aria-hidden', 'true');
            layer.style.cssText = 'position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:9998;';
            document.documentElement.append(layer);

            const animations: Animation[] = [];
            let created = 0;

            // Creamos los lomitos en tandas, una por frame, para no trabar el hilo principal
            const spawnBatch = () => {
                const batch = Math.min(perFrame, count - created);
                for (let i = 0; i < batch; i++) {
                    const lomito = document.createElement('span');
                    lomito.textContent = Math.random() < 0.85 ? '🥪' : '🍟';
                    const size = 22 + Math.random() * 34;
                    lomito.style.cssText = `position:absolute;top:-80px;left:${Math.random() * 100}vw;font-size:${size}px;line-height:1;`;
                    layer.append(lomito);

                    const drift = (Math.random() - 0.5) * 200;
                    const spin = (Math.random() - 0.5) * 720;
                    animations.push(lomito.animate(
                        [
                            { transform: 'translate(0, 0) rotate(0deg)' },
                            { transform: `translate(${drift}px, calc(100vh + 160px)) rotate(${spin}deg)` }
                        ],
                        {
                            duration: 2200 + Math.random() * 2200,
                            delay: Math.random() * 2000,
                            easing: 'cubic-bezier(0.35, 0, 0.8, 0.6)',
                            fill: 'both'
                        }
                    ));
                }
                created += batch;

                if (created < count) {
                    requestAnimationFrame(spawnBatch);
                } else {
                    Promise.all(animations.map(a => a.finished)).finally(() => {
                        layer.remove();
                        raining = false;
                    });
                }
            };

            requestAnimationFrame(spawnBatch);
        };

        document.addEventListener('click', (e) => {
            const badge = (e.target as HTMLElement).closest<HTMLElement>('[data-lomito-badge]');
            if (!badge || raining) return;

            const now = Date.now();
            clicks = clicks.filter(t => now - t < WINDOW_MS);
            clicks.push(now);
            const triggered = clicks.length >= CLICKS_NEEDED;

            // Pequeño "rebote" en cada click, así se siente que algo pasa
            const bounce = badge.animate(
                [{ transform: 'scale(1)' }, { transform: 'scale(1.12) rotate(-3deg)' }, { transform: 'scale(1)' }],
                { duration: 220, easing: 'ease-out' }
            );

            if (triggered) {
                clicks = [];
                raining = true;
                // La lluvia arranca recién cuando termina el rebote, así no compiten por el mismo frame
                bounce.finished.then(makeItRain, makeItRain);
            }
        });
    }
</script>

<!-- Mobile Menu Script -->
<script>
    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const icon = btn?.querySelector('i');
        const links = document.querySelectorAll('.mobile-link');

        let isMenuOpen = false;

        function toggleMenu() {
            isMenuOpen = !isMenuOpen;
            if (isMenuOpen) {
                menu?.classList.remove('translate-x-full');
                icon?.classList.remove('fa-bars');
                icon?.classList.add('fa-xmark');
                document.body.style.overflow = 'hidden'; // Prevent scrolling
            } else {
                menu?.classList.add('translate-x-full');
                icon?.classList.remove('fa-xmark');
                icon?.classList.add('fa-bars');
                document.body.style.overflow = '';
            }
        }

        btn?.addEventListener('click', toggleMenu);
        
        links.forEach(link => {
            link.addEventListener('click', () => {
                if(isMenuOpen) toggleMenu();
            });
        });
    });
</script>

<style>
    .logo-container {
        perspective: 1000px;
    }

    .logo-syllable {
        display: inline-block;
        transform-style: preserve-3d;
        backface-visibility: visible;
    }

    .logo-container:hover .logo-syllable {
        animation: roll-die 1.0s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    }

    .logo-container:hover .syllable-1 {
        animation-delay: 0s;
    }
    .logo-container:hover .syllable-2 {
        animation-delay: 0.15s;
    }
    .logo-container:hover .syllable-3 {
        animation-delay: 0.3s;
    }
    .logo-container:hover .syllable-4 {
        animation-delay: 0.45s;
    }

    @keyframes roll-die {
        0% {
            transform: rotateX(0deg);
        }
        100% {
            transform: rotateX(360deg);
        }
    }
</style>

